classDiagram
    class Owner {
        +str name
        +int day_start
        +int day_end
        +Preferences preferences
        +list~Pet~ pets
        +available_minutes() int
        +add_pet(pet: Pet) void
        +remove_pet(pet: Pet) void
        +get_all_tasks() list~tuple~Pet, Task~~
    }

    class Preferences {
        +dict category_windows
        +list quiet_hours
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) void
        +edit_task(task_id: str, **changes) void
        +remove_task(task_id: str) void
    }

    class Task {
        +str id
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +int preferred_start
        +Frequency frequency
        +int weekday
        +set~date~ completed_on
        +is_due(day: date) bool
        +is_completed(day: date) bool
        +mark_complete(day: date) void
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Scheduler {
        +Owner owner
        +DailyPlan plan
        +generate_plan(day: date) DailyPlan
        -due_tasks(day: date) list~tuple~
        -rank_tasks(pairs: list) list
        -find_slot(task: Task, cursor: int) int
        -explain_choice(pet: Pet, task: Task, scheduled: bool) str
    }

    class ScheduledItem {
        +Task task
        +Pet pet
        +int start_time
        +int end_time
        +str reason
    }

    class DailyPlan {
        +date date
        +list~ScheduledItem~ items
        +list~tuple~ skipped
        +total_minutes() int
        +summary() str
        +explain() str
    }

    Owner "1" *-- "0..*" Pet : owns
    Owner *-- Preferences : has
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : uses
    Task --> Frequency : repeats
    Scheduler --> Owner : plans for
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "0..*" ScheduledItem : contains
    ScheduledItem --> Task : snapshot of
    ScheduledItem --> Pet : for